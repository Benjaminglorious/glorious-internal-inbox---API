# 複製為 .env 後再改
PORT=3001
SESSION_SECRET=please-change-this-to-a-long-random-string
# DATABASE_PATH=./data/inbox.db

# 公司 WhatsApp click-to-chat（28car／glorious.hk／Facebook 用緊嘅號碼）。
# 未設定或空白時，程式預設用呢條。只係開新分頁連結。
# 入站派單唔係靠呢條 URL，而係靠資料庫 whatsapp_lines 嘅公司總機 85221740001。
COMPANY_WHATSAPP_URL=https://api.whatsapp.com/send?phone=85221740001

# GET hub.verify（/api/webhooks/whatsapp 同 /api/webhooks/meta）、
# POST /api/webhooks/site-comment，以及「有帶」X-Webhook-Token／Bearer 嘅 POST 共用。
# WhatsApp／Meta POST：未設定回 503。Meta 推送本身唔帶呢條 token；
# 若請求有 X-Webhook-Token 或 Bearer，就必須一致。
# 未設定或空白時 webhook 會拒絕（503）。請改成夠長隨機字串。
# 唔好將真實 token 提交入 git；.env 已在 .gitignore。
WEBHOOK_VERIFY_TOKEN=please-change-this-webhook-token

# --- Meta（Facebook Page／Instagram）— 入站骨架已接；出站 Graph 仍然 stub ---
# Developer Console Callback URL（生產）：
#   https://glorious-internal-inbox.onrender.com/api/webhooks/meta
# Verify token：上面 WEBHOOK_VERIFY_TOKEN
# 訂閱 Page／Instagram 相關欄位後，將下列填入 Render（唔好提交真實值）。
# META_APP_ID=
# META_APP_SECRET=
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# META_IG_BUSINESS_ACCOUNT_ID=
# 有 META_APP_SECRET 時，POST /api/webhooks/meta 同 /api/webhooks/whatsapp
# 都會驗證 X-Hub-Signature-256（唔啱回 401）；留空則跳過簽名。

# --- WhatsApp Cloud API 出站（公司總機 85221740001）---
# 同事喺收件箱回覆公司線先會用。同事個人線路唔用呢組。
# 唔好用 META_PAGE_ACCESS_TOKEN 代 WhatsApp token，亦唔好把真實 token 提交 git。
# Phone number id 未設定時，程式用生產預設 241163761376752。
# Access token 未設定時，公司線回覆標 failed，唔會當已發送。
# Render 要由 Tony 設定 WHATSAPP_ACCESS_TOKEN（必須）同 WHATSAPP_PHONE_NUMBER_ID（建議）。
# WHATSAPP_PHONE_NUMBER_ID=241163761376752
# WHATSAPP_ACCESS_TOKEN=
# 可選。未設定時用 v21.0。
# WHATSAPP_GRAPH_VERSION=v21.0

# Web Push（PWA 背景通知）。三項都留空 = 未啟用。
# 未設定時網頁仍然可以安裝，開住嘅分頁照樣有頁內提示；
# 關閉頁面之後就唔會收到推送。
# 產生一對金鑰（只印出嚟，唔好提交私鑰）：
#   npm run vapid:keys
# 將 publicKey／privateKey 分別貼去下面兩行。
# VAPID_SUBJECT 必須係 mailto: 或 https: URL。改完要重開伺服器。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# --- 28car 車盤／留言板（最多 10 個車行帳號）---
# 密碼同代理帳號只放環境變數。唔好提交真實值。下面只係格式。
# 即時讀寫預設關閉。即使把旗標設做 1，未有可輪換代理都唔會直連 28car。
#
# 每次登入、讀 mbr_sell.php、打開 sell_dsp.php、POST 留言都換一個出口 IP。
# 同一個短動作（登入＋緊接嗰一頁，或登入＋取 h_t/h_k＋POST）先至共用一個 IP。
# 下一個動作一定用另一個 IP。cookie 唔會帶去下一個 IP，所以每個動作自己再登入。
#
# 二擇一：
# 1) 至少兩個 http/https 代理（逗號、空白或 JSON 陣列）
# TWENTYEIGHT_CAR_PROXY_URLS=http://user:pass@proxy-a.example:8000,http://user:pass@proxy-b.example:8000
# 2) 供應商用 session 鎖 IP 時，網址含 {session}，每次動作換一個 session
# TWENTYEIGHT_CAR_PROXY_URL=http://user-{session}:pass@gate.example:8000
# 唔支援 socks://。一個冇 {session} 的代理唔夠，系統會拒絕出網。
#
# TWENTYEIGHT_CAR_ACCOUNTS_JSON=[{"username":"gmld28013@hotmail.com","password":"replace-me","display_name":"東榮汽車"}]
# 登入頁已確認：https://org.28car.com/mbr_login.php
# 倉庫冇登入表單 HTML，input name 未確認。唔好抄測試入面嘅 h_user／h_pwd。
# CONFIRM_ME 會被程式當未設定，所以唔會出登入 POST。瀏覽器見到 name 之後先改。
# TWENTYEIGHT_CAR_LOGIN_FORM_JSON={"url":"https://org.28car.com/mbr_login.php","username_field":"CONFIRM_ME","password_field":"CONFIRM_ME"}
# TWENTYEIGHT_CAR_SYNC_ENABLED=0
# TWENTYEIGHT_CAR_REPLY_POST_ENABLED=0
# TWENTYEIGHT_CAR_DEALER_ORIGIN=https://org.28car.com
# TWENTYEIGHT_CAR_PUBLIC_ORIGIN=https://www.28car.com
# TWENTYEIGHT_CAR_REQUEST_GAP_MS=2500
# TWENTYEIGHT_CAR_MAX_DETAIL_FETCHES=8
# TWENTYEIGHT_CAR_MAX_ACCOUNTS_PER_RUN=10

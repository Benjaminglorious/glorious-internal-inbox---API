{
  "name": "glorious-internal-inbox",
  "version": "1.0.0",
  "description": "東榮汽車內部同事留言處理系統（28car／官網／Facebook）",
  "main": "dist/index.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:demo": "tsx src/db/seed.ts",
    "seed:staff": "tsx src/db/seed-staff.ts",
    "clear:demo": "tsx src/db/clear-demo.ts",
    "demo:whatsapp-route": "tsx src/demo/whatsapp-route.ts",
    "demo:whatsapp-outbound": "tsx src/demo/whatsapp-outbound.ts",
    "demo:whatsapp-staff-send": "tsx src/demo/inbox-media.ts",
    "demo:inbox-media": "tsx src/demo/inbox-media.ts",
    "demo:meta-outbound": "tsx src/demo/meta-outbound.ts",
    "demo:staff-visibility": "tsx src/demo/staff-visibility.ts",
    "demo:inbox-search": "tsx src/demo/inbox-search.ts",
    "demo:inbox-preview": "tsx src/demo/inbox-customer-preview.ts",
    "demo:staff-time": "tsx src/demo/staff-time.ts",
    "demo:change-password": "tsx src/demo/change-password.ts",
    "vapid:keys": "web-push generate-vapid-keys --json",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/db',{recursive:true}); fs.copyFileSync('src/db/pg-worker.cjs','dist/db/pg-worker.cjs')\"",
    "start:prod": "node dist/index.js",
    "demo:site-comment": "tsx src/demo/site-comment-ingest.ts",
    "demo:commenter-thread": "tsx src/demo/commenter-thread.ts",
    "demo:28car": "tsx src/demo/twentyeightcar-sync.ts",
    "demo:clear-fixtures": "tsx src/demo/clear-fixtures.ts",
    "demo:postgres": "tsx src/demo/postgres-boot.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "connect-sqlite3": "^0.9.15",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "pg": "^8.16.0",
    "https-proxy-agent": "^7.0.6",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/pg": "^8.15.4",
    "@types/node": "^22.10.5",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "sqlite3@5.1.7": true,
    "esbuild@0.28.2": true
  }
}
